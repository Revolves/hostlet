ADMIN_PASSWORD=replace-with-a-long-password
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_PORT=3000
PAGES_PORT=8080
# Leave empty for the Node.js default (all interfaces); use 127.0.0.1 behind a local proxy.
BIND_ADDRESS=
PUBLIC_BASE_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
# Comma-separated origins. Include the Vite dev origin while using `npm run dev`.
ADMIN_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Comma-separated IPs or CIDRs of trusted reverse proxies; leave empty for direct connections.
TRUSTED_PROXY_IPS=
DATA_DIR=./data
COOKIE_SECURE=false
SECURITY_LOG_RETENTION_DAYS=180
MAX_UPLOAD_BYTES=52428800
# Multiuser mode is opt-in; review deployment and security requirements before public use.
MULTIUSER_ENABLED=false
REGISTRATION_ENABLED=false
# Allow password-only accounts without email verification. Username accounts
# cannot recover passwords by email; SMTP is still required for email accounts.
USERNAME_REGISTRATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional: enable private app hosting with a wildcard HTTPS domain.
APPS_DOMAIN=
# Explicit opt-in for one registrable domain: management stays on ADMIN_ORIGIN
# and apps use a subdomain such as apps.example.com. This weakens same-site
# isolation; use a separate registrable domain for stronger isolation.
SINGLE_DOMAIN_HOSTING=false
# Optional public source link. Omit to use https://github.com/Revolves; set empty to hide.
PUBLIC_GITHUB_URL=https://github.com/Revolves/hostlet
PUBLIC_GITHUB_LABEL=GitHub

