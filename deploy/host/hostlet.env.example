# Copy to /etc/hostlet/hostlet.env with mode 0640 root:hostlet and replace
# both secret values. Keep this file outside the source checkout.
ADMIN_PASSWORD=replace-with-a-long-private-password
APP_SECRET=replace-with-at-least-32-random-characters

ADMIN_PORT=3000
PAGES_PORT=8080
BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1

ADMIN_ORIGIN=https://hostlet.cn
ADMIN_ORIGINS=https://hostlet.cn
PUBLIC_BASE_URL=https://hostlet.cn
COOKIE_SECURE=true

DATA_DIR=/var/lib/hostlet
SECURITY_LOG_RETENTION_DAYS=180
MAX_UPLOAD_BYTES=52428800
PUBLIC_GITHUB_URL=https://github.com/Revolves
PUBLIC_GITHUB_LABEL=@Revolves

MULTIUSER_ENABLED=false
REGISTRATION_ENABLED=false
# Username accounts sign in without email verification. Email accounts still
# require SMTP configuration.
USERNAME_REGISTRATION_ENABLED=false
# For stronger isolation, use a separate registrable domain with wildcard DNS
# and TLS.
# APPS_DOMAIN=content.example.com
# For a one-domain demo deployment, opt in explicitly and use a subdomain:
# SINGLE_DOMAIN_HOSTING=true
# APPS_DOMAIN=apps.hostlet.cn
