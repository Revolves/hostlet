{
  "name": "hostlet",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": { "hostlet": "cli/hostlet.js" },
  "description": "An open-source multiuser platform for private and public static front-end hosting.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --config admin/vite.config.js",
    "build": "vite build --config admin/vite.config.js",
    "pack:cli": "npm pack ./cli",
    "pack:skill": "npm pack ./skills/hostlet-publish",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
