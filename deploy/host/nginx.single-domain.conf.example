# Single registrable domain with isolated application subdomains.
# Replace hostlet.cn and apps.hostlet.cn before use.
worker_processes auto;
error_log /var/log/nginx/error.log crit;
pid /run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  server_tokens off;

  client_body_timeout 30s;
  keepalive_timeout 30s;
  proxy_connect_timeout 10s;
  proxy_send_timeout 120s;
  proxy_read_timeout 120s;

  server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
  }

  server {
    listen 80;
    listen [::]:80;
    server_name hostlet.cn www.hostlet.cn;

    location ^~ /.well-known/acme-challenge/ {
      root /var/www/html;
      default_type text/plain;
    }

    location / {
      return 301 https://hostlet.cn$request_uri;
    }
  }

  server {
    listen 80;
    listen [::]:80;
    server_name *.apps.hostlet.cn;

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/hostlet/tls/fullchain.pem;
    ssl_certificate_key /etc/hostlet/tls/privkey.pem;
    return 444;
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.hostlet.cn;

    ssl_certificate /etc/hostlet/tls/fullchain.pem;
    ssl_certificate_key /etc/hostlet/tls/privkey.pem;
    return 301 https://hostlet.cn$request_uri;
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hostlet.cn;

    ssl_certificate /etc/hostlet/tls/fullchain.pem;
    ssl_certificate_key /etc/hostlet/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:hostlet_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 52m;
    proxy_request_buffering off;

    location ^~ /p/ {
      proxy_pass http://127.0.0.1:8080;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Forwarded "";
      proxy_cache off;
    }

    location / {
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Forwarded "";
      proxy_cache off;
    }
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.apps.hostlet.cn;

    ssl_certificate /etc/hostlet/tls/apps-fullchain.pem;
    ssl_certificate_key /etc/hostlet/tls/apps-privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:hostlet_apps_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
      proxy_pass http://127.0.0.1:8080;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header Forwarded "";
      proxy_cache off;
    }
  }
}
